# ── Platform-managed (set automatically on deploy — do not provide in custom secrets) ──

# Host and port — always set by the platform
HOST=0.0.0.0
PORT=5000

# Key Vault URL — set automatically when keyvault is enabled in infra-manifest.json
# AZURE_KV_URL=               # (platform-managed, do not set manually)

# ── Custom variables (you will be prompted for production values on deploy) ──

# eToro API credentials (used for GET requests — Short-Tech account)
ETORO_API_KEY=              # Your eToro API key
ETORO_USER_KEY=             # Your eToro user key
ETORO_API_BASE_URL=         # eToro API base URL (default: https://public-api.etoro.com)
PORTFOLIO_CREDENTIALS=      # JSON object with portfolio-specific credentials (apiKey, userKey, gcid per portfolio)

# Anthropic API key for AI-powered post generation and portfolio analysis
ANTHROPIC_API_KEY=          # Your Anthropic API key

# Alpha Vantage - financial news discovery
ALPHA_VANTAGE_API_KEY=      # Your Alpha Vantage API key

# Firecrawl - article scraping
FIRECRAWL_API_KEY=          # Your Firecrawl API key

# Cloudinary - image hosting for post images
CLOUDINARY_CLOUD_NAME=      # Your Cloudinary cloud name
CLOUDINARY_API_KEY=         # Your Cloudinary API key
CLOUDINARY_API_SECRET=      # Your Cloudinary API secret
